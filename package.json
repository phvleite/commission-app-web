{
    "name": "commission-app-web",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "dev:turbo": "next dev",
        "puppeteer:install": "puppeteer browsers install chrome",
        "build": "npm run puppeteer:install && npm run build:app",
        "build:app": "next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "seed:platform-owner": "node scripts/seed-platform-owner.mjs",
        "migrate:commission-processes": "npx tsx src/lib/migrations/002-backfill-successful-commission-processes.ts",
        "migrate:employee-sector-history": "npx tsx src/lib/migrations/003-backfill-employee-sector-history.ts",
        "migrate:situation-types": "npx tsx src/lib/migrations/004-seed-situation-types.ts",
        "migrate:snapshot-names": "npx tsx src/lib/migrations/005-backfill-snapshot-names.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "mongoose": "^9.7.4",
        "next": "16.3.6",
        "next-auth": "^5.0.0-beta.31",
        "nodemailer": "8.0.11",
        "pdfkit": "0.20.2",
        "puppeteer": "24.43.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "sonner": "^2.0.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/nodemailer": "8.0.1",
        "@types/pdfkit": "0.17.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "mongodb-memory-server": "^11.2.0",
        "pdf-lib": "1.17.1",
        "prettier": "^3.9.5",
        "tailwindcss": "^4",
        "ts-jest": "^29.4.11",
        "tsx": "^4.23.13",
        "typescript": "^5"
    }
}
